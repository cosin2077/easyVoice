OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxx
MODEL_NAME=gpt-4o-mini

# SSRF protection: an openaiBaseUrl supplied by a user (web page / API body) must be a public
# http(s) address. Set to true ONLY for private self-hosting where users must point at a
# local / LAN LLM (e.g. http://127.0.0.1:11434/v1). Cloud metadata and other reserved
# addresses stay blocked either way. OPENAI_BASE_URL above is operator config and is never
# restricted, so a local LLM there does not need this.
# ALLOW_PRIVATE_OPENAI_URL=false

# Optional login. When both are set, the web UI and TTS / audio / subtitle
# endpoints require a username and password. Leave both empty to keep the
# service open (the previous default). Setting only one of them will prevent
# the server from starting.
# Generate AUTH_PASSWORD_HASH with: node scripts/hash-password.mjs
# AUTH_USERNAME=operator
# AUTH_PASSWORD_HASH=scrypt$16384$8$1$32$...
# Optional: session lifetime in ms (default 7 days), extra allowed CORS origins,
# and cookie name.
# AUTH_SESSION_TTL_MS=604800000
# AUTH_CORS_ORIGINS=https://your.example
# AUTH_COOKIE_NAME=ev_session
