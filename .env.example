OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxx
MODEL_NAME=gpt-4o-mini

# SSRF protection: an openaiBaseUrl supplied by a user (web page / API body) must be a public
# http(s) address. Set to true ONLY for private self-hosting where users must point at a
# local / LAN LLM (e.g. http://127.0.0.1:11434/v1). Cloud metadata and other reserved
# addresses stay blocked either way. OPENAI_BASE_URL above is operator config and is never
# restricted, so a local LLM there does not need this.
# ALLOW_PRIVATE_OPENAI_URL=false
